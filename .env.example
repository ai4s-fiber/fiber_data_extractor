DATABASE_URL=sqlite+aiosqlite:///./fiber_data.db
ALLOW_SQLITE_FALLBACK=true
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
PARSE_ARTIFACT_DIR=./parse_artifacts
# NAS roots are server-side paths. Use JSON for UNC paths, for example:
# NAS_SOURCE_ROOTS=["\\\\nas-server\\papers","Z:\\incoming"]
NAS_SOURCE_ROOTS=
NAS_SCAN_MAX_FILES=5000
NAS_MAX_FILE_BYTES=104857600

# New Materials Big Data Center direct-import binding. Keep the template,
# dataset ID, template ID and SHA-256 in sync; validation fails closed.
PLATFORM_BASE_URL=http://192.168.2.101/database-code
PLATFORM_BATCH_TEMPLATE_PATH=../platform_templates/canary/platform-batch-canary.json
PLATFORM_EXPECTED_DATASET_ID=2081660157305163778
PLATFORM_EXPECTED_TEMPLATE_ID=2081658374180704257
PLATFORM_BATCH_TEMPLATE_SHA256=d001d4d70df42a34644cf8704dd77ede99dc6eb7e89626b8778cd353d34465a2
PLATFORM_MATERIAL_FACT_TEMPLATE_PATH=../platform_templates/ai4s-material-chain-template-v0.3.2.json
PLATFORM_MATERIAL_FACT_TEMPLATE_SHA256=5ca1f62e96681fe30e5936738daed802d67c6fa6034e81cbbd90bab4ac4fa279
PLATFORM_MATERIAL_FACT_DATASET_ID=2082071264142430210
PLATFORM_MATERIAL_FACT_TEMPLATE_ID=2082071243661643777
PLATFORM_MATERIAL_FACT_DATASET_NAME=AI4S材料数据链_成分工艺结构性能_v0.3.2_20260728
PLATFORM_SESSION_TTL_SECONDS=14400
PLATFORM_PARSE_TIMEOUT_SECONDS=180
PLATFORM_POLL_INTERVAL_SECONDS=2

MINERU_ENABLED=true
MINERU_API_URL=http://127.0.0.1:8001
MINERU_CLOUD_TOKEN=
MINERU_CLOUD_TRUST_ENV=true
MINERU_CLOUD_MODEL_VERSION=vlm
MINERU_CLOUD_PAGE_RANGES=
MINERU_CLOUD_ENABLE_FORMULA=true
MINERU_CLOUD_ENABLE_TABLE=true
MINERU_CLOUD_IS_OCR=false
MINERU_CLOUD_BATCH_SIZE=20
MINERU_CLOUD_UPLOAD_CONCURRENCY=8
MINERU_CLOUD_MAX_RETRIES=4
MINERU_CLOUD_RETRY_BASE_SECONDS=2
MINERU_REUSE_PARSE_ARTIFACTS=true
MINERU_CLOUD_FALLBACK_LOCAL=false
MINERU_FALLBACK_LEGACY_PARSER=false
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_IMAGE_ANALYSIS_ENABLE=true
MINERU_HYBRID_EFFORT=medium
DEFAULT_PARSER_STRATEGY=mineru_cloud
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_BASE_URL=https://aigw.sotatts.online/v1
DEFAULT_LLM_MODEL=gpt-5.5
EXTRACTION_MAX_CONCURRENT_JOBS=3
EXTRACTION_MAX_ATTEMPTS=2
EXTRACTION_RETRY_BASE_SECONDS=5
EXTRACTION_PIPELINE_TIMEOUT_SECONDS=1800
EXTRACT_REVIEW_ARTICLES=false
STRONG_LLM_PARALLEL_CALLS=4
STRONG_HOLISTIC_SAMPLE_MAX_CHARS=16000
STRONG_HOLISTIC_CATALOG_REASONING_EFFORT=low
STRONG_HOLISTIC_CATALOG_RETRY_ENABLED=true
STRONG_HOLISTIC_CATALOG_RETRY_MAX_CHARS=8000
STRONG_HOLISTIC_CATALOG_RETRY_MAX_TOKENS=1800
STRONG_HOLISTIC_PERFORMANCE_TIMEOUT_SECONDS=180
STRONG_HOLISTIC_PERFORMANCE_WINDOW_CHARS=6000
STRONG_HOLISTIC_WINDOW_OVERLAP_BLOCKS=1
STRONG_HOLISTIC_RESULT_MIN_SCORE=4
STRONG_HOLISTIC_MAX_RESULT_BLOCKS=80
STRONG_HOLISTIC_RESULT_NEIGHBOR_BLOCKS=1
STRONG_HOLISTIC_SKIP_EMPTY_PERFORMANCE=true
STRONG_HOLISTIC_PARALLEL_CALLS=3
STRONG_HOLISTIC_BACKGROUND_TIMEOUT_SECONDS=60
STRONG_HOLISTIC_BACKGROUND_MAX_CHARS=9000
STRONG_HOLISTIC_BACKGROUND_MAX_TOKENS=1400
STRONG_TABLE_LLM_TIMEOUT_SECONDS=75
STRONG_STAGE2_PARTIAL_FAILURE_MIN_FACTS=3
LLM_DEFAULT_REASONING_EFFORT=low
LLM_REQUEST_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0
LLM_RETRY_MAX_SECONDS=20.0
LLM_GLOBAL_MAX_CONCURRENT_CALLS=16
LLM_BATCH_MAX_CONCURRENT_CALLS=12
LLM_INTERACTIVE_RESERVED_CALLS=4

# Docker Compose PostgreSQL settings
POSTGRES_DB=fiber_v6
POSTGRES_USER=fiber
